("type": "number",) Tj T*
("description": "Stock price") Tj T*
(},) Tj T*
("date": {) Tj T*
("type": "string",) Tj T*
("description": "Stock price date") Tj T*
(}) Tj T*
(},) Tj T*
("required": ["price", "date"]) Tj T*
(},) Tj T*
("annotations": {) Tj T*
("readOnlyHint": "true") Tj T*
(}) Tj T*
(}) Tj T*
ET
