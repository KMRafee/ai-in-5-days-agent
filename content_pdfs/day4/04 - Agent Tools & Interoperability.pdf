(Page 41 of 49 - 04 - Agent Tools & Interoperability) Tj T*
(Agent Tools & Interoperability) Tj T*
(May 2026) Tj T*
(41) Tj T*
(agent = LlmAgent\() Tj T*
(model=Gemini\(model="gemini-flash-latest"\),) Tj T*
(name="ui_agent",) Tj T*
(instruction=schema_manager.generate_system_prompt\() Tj T*
(role_description="You generate interactive UIs as A2UI v0.9 messages.",) Tj T*
(ui_description="Use Cards, Lists, ChoicePickers, and Buttons to) Tj T*
(present data.",) Tj T*
(include_schema=True,) Tj T*
(include_examples=True,) Tj T*
(\),) Tj T*
(\)) Tj T*
(# 2. Run the agent. It emits text containing one or) Tj T*
(more <a2ui-json>...</a2ui-json>) Tj T*
(#    blocks; parse_response\(\) extracts the parsed JSON. Validate, then retry) Tj T*
(on errors.) Tj T*
(async def create_ui\(intent: str, data: dict, max_retries: int = 3\) -> list:) Tj T*
(runner = InMemoryRunner\(agent=agent, app_name="ui_demo"\)) Tj T*
(session = await runner.session_service.create_session\() Tj T*
(app_name="ui_demo", user_id="u",) Tj T*
(state={"expression": "{expression}"},  # escapes the SDK's) Tj T*
(templating placeholder) Tj T*
(\)) Tj T*
(query = f"{intent}\\n\\nData: {json.dumps\(data\)}") Tj T*
(last_error = None) Tj T*
(for _ in range\(max_retries + 1\):) Tj T*
(chunks = []) Tj T*
(msg = types.Content\(role="user", parts=[types.Part\(text=query\)]\)) Tj T*
(async for ev in runner.run_async\(user_id="u",) Tj T*
(session_id=session.id, new_message=msg\):) Tj T*
(if ev.content and ev.content.parts:) Tj T*
(chunks.extend\(p.text for p in ev.content.parts if p.text\)) Tj T*
(blocks = [rp.a2ui_json for rp in parse_response\("".join\(chunks\)\)) Tj T*
(if rp.a2ui_json]) Tj T*
(try:) Tj T*
(for b in blocks:) Tj T*
(for m in \(b if isinstance\(b, list\) else [b]\):) Tj T*
(catalog.validator.validate\(m\)) Tj T*
(return blocks) Tj T*
(except jsonschema.ValidationError as e:) Tj T*
(Continues next page...) Tj T*
ET
